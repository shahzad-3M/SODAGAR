# Production Environment Mode (set to "production" on Hostinger)
NODE_ENV=production

# SESSION_SECRET: Stable secret key for signing authentication tokens across deployments (required in production)
SESSION_SECRET=

# MySQL Database Connection (required in production; SQLite fallback is disabled when NODE_ENV=production)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Optional local development / cross-domain overrides (never set DB_DRIVER=sqlite in production)
# VITE_API_BASE_URL=
# CORS_ALLOWED_ORIGINS=
# GEMINI_API_KEY=
# ADMIN_MASTER_PIN=

# Optional Meta WhatsApp Cloud API Integration (leave blank if using customer click-to-WhatsApp / support fallback)
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_ORDER_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANG=en
