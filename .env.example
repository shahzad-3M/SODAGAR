# GEMINI_API_KEY: Optional AI key if enabling server-side AI features
GEMINI_API_KEY=

# SESSION_SECRET: Secret key used to sign authentication session tokens (generate a random 32+ char hex string in production)
SESSION_SECRET=

# ADMIN_MASTER_PIN: Optional server-side override PIN for the Super Admin account (never exposed to client bundles)
ADMIN_MASTER_PIN=
